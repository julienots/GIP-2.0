{
  "name": "gip-browser",
  "productName": "Gip 2.0",
  "version": "2.0.0",
  "description": "Gip 2.0 — navigateur internet complet, axé vie privée, avec ses propres services et comptes internes chiffrés.",
  "main": "src/main/main.js",
  "author": "Gip",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "check": "node scripts/check.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.gip.browser",
    "productName": "Gip 2.0",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "protocols": [
      {
        "name": "Gip internal pages",
        "schemes": [
          "gip"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    }
  }
}
